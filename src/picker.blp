using Gtk 4.0;
using Adw 1;

template $HatchetPicker: Adw.Bin {
  styles ["picker"]

  child: Box {
    orientation: vertical;

    Box {
      margin-bottom: 6;
      orientation: horizontal;

      Text text_entry {
        hexpand: true;
        map => $_text_map_cb();
        changed => $_text_changed_cb();
        activate => $_text_activated_cb();
      }
    }

    ScrolledWindow {
      vexpand: true;
      propagate-natural-height: true;

      child: ListView list_view {
        model: SingleSelection selection {
          notify::selected => $_selection_changed_cb();
        };
        factory: BuilderListItemFactory {
          template ListItem {
            child: Label {
              xalign: 0.0;
              label: bind template.item as <StringObject>.string as <string>;
            };
          }
        };
        activate => $_activated_cb();
      };
    }
  };
}
