{
  "id" : "net.kolunmi.Hatchet",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "master",
  "sdk" : "org.gnome.Sdk",
  "command" : "hatchet",
  "finish-args" : [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland"
  ],
  "cleanup" : [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules" : [
    {
      "name" : "hatchet",
      "builddir" : true,
      "buildsystem" : "meson",
      "sources" : [
        {
          "type" : "dir",
          "path" : "."
        }
      ],
      "modules": [
        "foundry/libfoundry.json"
      ]
    }
  ]
}
